# ── Mobile app environment ────────────────────────────────────────────────────
# Used by local dev (`npx expo start`) and Expo Go. EAS builds inject these via
# eas.json profiles + EAS secrets instead — see app/README.md.

# Backend API base URL.
#   Emulator + local backend : http://localhost:8000      (Android emulator
#                             aliases 10.0.2.2 → host loopback in Expo Go)
#   Physical device, dev     : http://<your-machine-LAN-IP>:8000
#   Release builds           : MUST be HTTPS (see README — the app refuses to
#                              ship pointing at localhost)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Web console base URL (optional). When set, the student InClass screen shows
# a "Join audio/video in browser" deep link into the web classroom.
EXPO_PUBLIC_WEB_URL=
