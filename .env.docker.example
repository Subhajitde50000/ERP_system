# ==============================================================================
# ERP System — Unified Docker Environment Configuration
# Copy this file to .env before starting docker-compose:
#   cp .env.docker.example .env
# ==============================================================================

# ─── Database Configuration ──────────────────────────────────────────────────
POSTGRES_DB=erp_db
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_secure_password_change_in_prod
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─── Redis Configuration ─────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── Backend Configuration ───────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
PORT=8000
PUBLIC_ROOT_DOMAIN=xyz.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost,http://xyz.com,https://xyz.com

# JWT Secret Key (Generate in production with: openssl rand -hex 32)
JWT_SECRET_KEY=dev-secret-key-change-this-in-production-must-be-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Provider (console | google | klaviyo)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@xyz.com
EMAIL_FROM_NAME=ERP Platform

# Optional Gmail SMTP settings
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASSWORD=

# ─── Frontend Configuration ──────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ROOT_DOMAIN=xyz.com

# Optional Firebase Web Push
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
