# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be a long random string — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
# Production: https://xyz.com,https://app.xyz.com (and approved tenant origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
# Set to false in production — hides /docs, /redoc, and stack traces
APP_DEBUG=true

# ─── Signup / provisioning ───────────────────────────────────────────────────
# Root domain used for subdomain checks and login URLs (green.xyz.com)
PUBLIC_ROOT_DOMAIN=xyz.com
# Free-trial length in days
TRIAL_DAYS=14
# Default timezone written to newly provisioned tenants
TENANT_DEFAULT_TIMEZONE=Asia/Kolkata

# ─── Email ───────────────────────────────────────────────────────────────────
# Which system sends mail. Only ONE is active at a time.
#   google  → Gmail / Google Workspace SMTP
#   klaviyo → Klaviyo Events API (triggers a Klaviyo Flow)
#   console → log to stdout only, never delivers (safe default for dev)
# You can also switch by commenting a block in app/services/mailer/registry.py;
# a provider commented out there is ignored even if named here.
EMAIL_PROVIDER=console

# Shared envelope identity (used by both providers)
EMAIL_FROM=no-reply@xyz.com
EMAIL_FROM_NAME=xyz.com ERP
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=20

# ── Option 1: GOOGLE (Gmail / Workspace SMTP) ────────────────────────────────
# Requires 2-Step Verification + an App Password (NOT your Google password):
#   https://myaccount.google.com/apppasswords
# Port 587 = STARTTLS (default), 465 = implicit TLS.
GOOGLE_SMTP_HOST=dessubhajit00@gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_USER=desubhajit00@gmail.com
GOOGLE_SMTP_PASSWORD=wjsb cwjq iqqy tnxn

# ── Option 2: KLAVIYO (Events API → Flow) ────────────────────────────────────
# Private key (pk_...) with Events:write + Profiles:write scopes.
# Klaviyo does not send raw email by API: this fires a metric named
# "<prefix> <event>" (e.g. "ERP owner.verify_email"); build one transactional
# Flow per metric in Klaviyo and point it at your template.
KLAVIYO_API_KEY=
KLAVIYO_API_REVISION=2024-10-15
KLAVIYO_METRIC_PREFIX=ERP

# ─── Firebase Cloud Messaging (push notifications) ──────────────────────────
# Push is optional: leave the two fields below empty and only the in-app DB
# inbox is used (development/tests). To enable Android/iOS/web push:
#   1. Create a Firebase project and add an Android app, an iOS app and a Web
#      app (console.firebase.google.com).
#   2. In Firebase → Project settings → Service accounts, generate a new
#      private key (a Google service-account JSON) and either point
#      FCM_SERVICE_ACCOUNT_JSON at it, or base64 it into
#      FCM_SERVICE_ACCOUNT_B64.
#   3. Enable the "Firebase Cloud Messaging API" for that service account.
# Web push additionally needs the Web app's VAPID key (see
# fontend/.env.example: NEXT_PUBLIC_FIREBASE_*).
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_B64=
FCM_PROJECT_ID=
# Message time-to-live in seconds (defaults to 1 day).
FCM_TTL_SECONDS=86400
# Delivery-worker batch size (outbox rows claimed per sweep).
NOTIFICATION_PUSH_BATCH_SIZE=100
