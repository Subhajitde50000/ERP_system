# ─── Backend API ─────────────────────────────────────────────────────────────
# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-only override used by Server Components (tenant lookup) when
# the browser-facing URL is not reachable from inside the container/network,
# e.g. API_INTERNAL_URL=http://api:8000 in docker-compose. Defaults to the above.
API_INTERNAL_URL=

# ─── Domain ───────────────────────────────────────────────────────────────────
# Root domain used for subdomain → tenant resolution
# Local multi-tenant testing: use abc-college.localhost (no value needed)
NEXT_PUBLIC_ROOT_DOMAIN=shikshasync.me

# ─── Firebase web push (website notifications) ──────────────────────────────
# Create a Web app in the same Firebase project used for the mobile apps
# (console.firebase.google.com → Project settings → Your apps → Web app) and
# copy these values. NEXT_PUBLIC_FIREBASE_VAPID_KEY comes from Project
# settings → Cloud Messaging → Web configuration → Key pair.
# When these are left empty the "Browser notifications" panel is hidden and
# the app works exactly as before (in-app inbox only).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
